# Copy to .env for local development. In AWS use ECS task env / Secrets Manager.

# =============================================================================
# 1. APP & SECURITY
# =============================================================================
ENVIRONMENT=development          # production => JSON logs
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=[]         # JSON list, e.g. ["https://app.example.com"]

# =============================================================================
# 2. LLM PROVIDER: openai | ollama | aws_bedrock
# =============================================================================
LLM_SERVICE=openai

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Optional faster model for the query-rewrite call only (same provider). Empty = use the chat model.
REWRITE_MODEL=gpt-4o-mini
# false: standalone questions are only classified and searched as typed.
# true: they are also rewritten. Follow-ups are always rewritten.
REWRITE_STANDALONE_QUESTIONS=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_QUERY_TIMEOUT_SECONDS=2
EMBEDDING_QUERY_MAX_RETRIES=2

# --- Ollama ------------------------------------------------------------------
OLLAMA_API_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:14b
OLLAMA_EMBEDDING_MODEL=snowflake-arctic-embed2:latest

# --- AWS Bedrock -------------------------------------------------------------
# On AWS leave the key pair empty: the task/instance IAM role is used.
AWS_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_CHAT_MODEL_ID=us.meta.llama3-3-70b-instruct-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# =============================================================================
# 3. LLM FALLBACK (OpenRouter)
# =============================================================================
LLM_FALLBACK_ENABLED=true
OPENROUTER_API_KEY=
FALLBACK_TIMEOUT_SECONDS=20

# =============================================================================
# WEB SEARCH (Tavily). Empty key = web search off.
# =============================================================================
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=10

# =============================================================================
# 4. VECTOR STORE (Weaviate)
# =============================================================================
WEAVIATE_CONNECTION_TYPE=local   # local (docker/ECS/EKS/EC2) | cloud (Weaviate Cloud)
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_CLUSTER_URL=
WEAVIATE_API_KEY=
WEAVIATE_HYBRID_ALPHA=0.7

# =============================================================================
# 5. INGESTION & INDEX DEFAULTS
# =============================================================================
INDEX_NAME=Documents
DEFAULT_NAMESPACE=default
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE_MB=200

# =============================================================================
# 6. RETRIEVAL: RERANKER (cross-encoder)
# =============================================================================
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=5              # hybrid results scored by the cross-encoder
HF_TOKEN=                        # Hugging Face token for model downloads

# =============================================================================
# Chat memory (Postgres on AWS RDS). Unset = stateless: the browser resends the history.
# =============================================================================
POSTGRES_URL=postgresql://USER:PASSWORD@your-db.xxxxxx.REGION.rds.amazonaws.com:5432/rag?sslmode=require
# No RDS? Use Docker Postgres instead (see README "Run locally"):
#   POSTGRES_URL=postgresql://rag:rag@localhost:5432/rag
POSTGRES_POOL_MAX_SIZE=10

# =============================================================================
# 7. CACHING (Redis + semantic cache)
# =============================================================================
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379/0

SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_SECONDS=86400

# =============================================================================
# 8. RATE LIMITING
# =============================================================================
# OpenAI budget per model per minute (80% of the Build tier: 5,000 RPM / 2M TPM)
ANSWER_MODEL_RPM_BUDGET=4000
ANSWER_MODEL_TPM_BUDGET=1600000
REWRITE_MODEL_RPM_BUDGET=4000
REWRITE_MODEL_TPM_BUDGET=1600000

# =============================================================================
# 9. OBSERVABILITY (LangSmith)
# =============================================================================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-project
